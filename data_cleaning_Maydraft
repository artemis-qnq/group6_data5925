def read_patient(path):
    df = pd.read_csv(path)
    df["Value"] = pd.to_numeric(df["Value"], errors="coerce")
    t = pd.to_timedelta(df["Time"] + ":00")  # "01:20" -> "01:20:00"
    df["minute"] = (t.dt.total_seconds() // 60).astype(int)
    df["hour"] = (df["minute"] // 60).clip(0, 47)  # จำกัด 0..47 ชม.
    return df

def process_patient(file_path):
    df0 = read_patient(file_path)    
    df1 = df0.sort_values(["hour", "minute"])
    g = df1.groupby(["hour", "Parameter"], as_index=False)["Value"].last() #use lastest 
    # pivot
    X = g.pivot(index="hour", columns="Parameter", values="Value")
    X = X.reindex(range(48))
    
    #static variables
    general_var = ['Age','Gender','Height','ICUType','RecordID']  #some patient weight is not cosistant
    for col in general_var:
        if col in X.columns:
            X[col] = X[col].ffill().bfill()

    record_id = int(file_path.stem)
    X["RecordID"] = record_id
    X = X.reset_index()
    cols = ["RecordID", "hour"] + [c for c in X.columns if c not in ["RecordID", "hour"]]
    X = X[cols]
    return X

